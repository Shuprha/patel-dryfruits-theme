{{ 'gift-collection-tabs.css' | asset_url | stylesheet_tag }}
{{ 'gifting-faq-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gift-collection-tabs.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign products_per_tab = section.settings.products_per_tab | default: 4
  assign classes = 'm-section m-gift-tabs'
  if section.settings.color_scheme != blank
    assign classes = classes | append: ' m-color-' | append: section.settings.color_scheme
  endif
-%}

<gift-collection-tabs class="{{ classes }}" data-section-id="{{ section.id }}" data-section-type="gift-collection-tabs">
  <div class="{{ container }} m-section-my">
    {%- render 'index-section-header', section_settings: section.settings -%}

    {%- if section.blocks.size > 0 -%}
      <div class="m-gift-tabs__nav{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}" role="tablist">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="m-gift-tabs__nav-item{% if forloop.first %} is-active{% endif %}"
            data-tab-index="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.label | default: block.settings.collection.title -}}
          </button>
        {%- endfor -%}
      </div>

      <div class="m-gift-tabs__panels{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        {%- for block in section.blocks -%}
          {%- assign tab_collection = collections[block.settings.collection] -%}
          <div
            class="m-gift-tabs__panel{% if forloop.first %} is-active{% endif %}"
            data-tab-panel="{{ forloop.index0 }}"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div class="m-gift-tabs__grid m:flex m:flex-wrap">
              {%- if tab_collection != blank -%}
                {%- for product in tab_collection.products limit: products_per_tab -%}
                  <div class="m-gift-tabs__item m:column m:w-1/2 md:m:w-1/4">
                    {%- render 'product-card-1',
                      product: product,
                      hide_title: false,
                      show_cart_button: false,
                      show_quickview_button: false,
                      show_wishlist_button: false,
                      show_compare_button: false,
                      index: forloop.index,
                      animated: false
                    -%}
                    <a href="{{ product.url }}" class="m-button m-button--primary m-gift-tabs__show-btn">
                      {{ section.settings.card_button_label | default: 'Show now' }}
                    </a>
                  </div>
                {%- else -%}
                  <p class="m-gift-tabs__empty">{{ 'This collection has no products yet.' }}</p>
                {%- endfor -%}
              {%- else -%}
                <p class="m-gift-tabs__empty">{{ 'Select a collection for this tab in the theme editor.' }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</gift-collection-tabs>

{% schema %}
{
  "name": "Gift collection tabs",
  "class": "m-shopify-section-gift-collection-tabs",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "w-full", "label": "Full width" },
        { "value": "container", "label": "Use container box" }
      ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gift boxes & hampers" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h3",
      "options": [
        { "label": "Medium", "value": "h3" },
        { "label": "Large", "value": "h2" }
      ]
    },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "textarea", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    { "type": "header", "content": "Products" },
    {
      "type": "range",
      "id": "products_per_tab",
      "label": "Products per tab",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "card_button_label",
      "label": "Product card button label",
      "default": "Show now"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Animations",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "All Boxes" },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gift collection tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "All Boxes" } },
        { "type": "tab", "settings": { "label": "Festive Hampers" } },
        { "type": "tab", "settings": { "label": "Premium Trays" } },
        { "type": "tab", "settings": { "label": "Mini Favours" } },
        { "type": "tab", "settings": { "label": "Corporate Sets" } }
      ]
    }
  ]
}
{% endschema %}
