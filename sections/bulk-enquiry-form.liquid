{{ 'gift-forms.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
-%}

<section
  class="m-section m-gift-form-page{% if section.settings.header_bg != blank %} m-gift-form-page--custom-bg{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="bulk-enquiry-form"
  {% if section.settings.header_bg != blank %}style="--gift-form-header-bg: {{ section.settings.header_bg }};"{% endif %}
>
  <div class="m-gift-form-page__header{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
    <div class="{{ container }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="m-gift-form-page__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="m-gift-form-page__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="m-gift-form-page__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="{{ container }} m-section-my">
    <div class="m-gift-form-card m:flex m:flex-wrap{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-gift-form-card__media m:w-full lg:m:w-5/12">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', class: 'm-gift-form-card__img', sizes: '(min-width: 1024px) 41vw, 100vw'
          }}
        {%- endif -%}
      </div>

      <div class="m-gift-form-card__form m:w-full lg:m:w-7/12">
        {%- form 'contact', id: 'BulkCorporateEnquiryForm', class: 'm-gift-form' -%}
          {%- capture success_message -%}{{ 'contact.form.post_success' | t }}{%- endcapture -%}
          {%- render 'form__success', form: form, success_message: success_message -%}
          {%- render 'form__error', form: form -%}

          <input type="hidden" name="contact[Form Type]" value="Bulk & Corporate Gifting Enquiry">

          <div class="m-gift-form__row m:flex m:flex-wrap">
            <div class="m-gift-form__field m:column m:w-full md:m:w-1/2">
              <input
                type="text"
                class="form-field form-field--input"
                name="contact[Company / Organisation]"
                placeholder="{{ section.settings.company_label | default: 'Company / Organisation' }}"
                required
              >
            </div>
            <div class="m-gift-form__field m:column m:w-full md:m:w-1/2">
              <input
                type="text"
                class="form-field form-field--input"
                name="contact[Contact Person]"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="{{ section.settings.contact_person_label | default: 'Contact Person' }}"
                required
              >
            </div>

            <div class="m-gift-form__field m:column m:w-full md:m:w-1/2">
              <input
                type="tel"
                class="form-field form-field--input"
                name="contact[phone]"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="{{ section.settings.phone_label | default: 'Phone' }}"
                required
              >
            </div>
            <div class="m-gift-form__field m:column m:w-full md:m:w-1/2">
              <input
                type="email"
                class="form-field form-field--input"
                name="contact[email]"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ section.settings.email_label | default: 'Email' }}"
                autocorrect="off"
                autocapitalize="off"
                required
              >
            </div>

            <div class="m-gift-form__field m:column m:w-full md:m:w-1/2">
              <input
                type="text"
                class="form-field form-field--input"
                name="contact[No. of Units]"
                placeholder="{{ section.settings.units_label | default: 'No. of Units' }}"
              >
            </div>
            <div class="m-gift-form__field m:column m:w-full md:m:w-1/2">
              <input
                type="text"
                class="form-field form-field--input"
                name="contact[Required By]"
                onfocus="(this.type='date')"
                onblur="if(!this.value){this.type='text'}"
                placeholder="{{ section.settings.required_by_label | default: 'Required By' }}"
              >
            </div>

            <div class="m-gift-form__field m:column m:w-full">
              <textarea
                class="form-field form-field--input"
                name="contact[body]"
                rows="4"
                placeholder="{{ section.settings.details_label | default: 'Requirement Details' }}"
              >{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
            </div>
          </div>

          <div class="m-gift-form__footer m:flex m:flex-wrap">
            <button type="submit" class="m-button m-button--primary">
              {{ section.settings.submit_label | default: 'Submit Corporate Enquiry' }}
            </button>
            {%- if section.settings.helper_text != blank -%}
              <p class="m-gift-form__helper">{{ section.settings.helper_text }}</p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bulk enquiry form",
  "class": "m-shopify-section-bulk-enquiry-form",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container-fluid",
      "options": [
        { "value": "container-fluid", "label": "Default" },
        { "value": "w-full", "label": "Full width" },
        { "value": "container", "label": "Use container box" }
      ]
    },
    { "type": "header", "content": "Header banner" },
    { "type": "color", "id": "header_bg", "label": "Header background color", "default": "#FBEEC7" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bulk & Corporate Gifting" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Subtext",
      "default": "Gifting for your team, clients, or event? Let's discuss volume, branding, and timelines."
    },
    { "type": "header", "content": "Form" },
    { "type": "image_picker", "id": "image", "label": "Side image" },
    { "type": "text", "id": "company_label", "label": "Company placeholder", "default": "Company / Organisation" },
    { "type": "text", "id": "contact_person_label", "label": "Contact person placeholder", "default": "Contact Person" },
    { "type": "text", "id": "phone_label", "label": "Phone placeholder", "default": "Phone" },
    { "type": "text", "id": "email_label", "label": "Email placeholder", "default": "Email" },
    { "type": "text", "id": "units_label", "label": "No. of units placeholder", "default": "No. of Units" },
    { "type": "text", "id": "required_by_label", "label": "Required by placeholder", "default": "Required By" },
    { "type": "text", "id": "details_label", "label": "Requirement details placeholder", "default": "Requirement Details" },
    { "type": "text", "id": "submit_label", "label": "Submit button label", "default": "Submit Corporate Enquiry" },
    {
      "type": "text",
      "id": "helper_text",
      "label": "Helper text",
      "default": "Dedicated account manager assigned for orders above 100 units."
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Animations",
      "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Inherit" },
        { "value": "none", "label": "None" },
        { "value": "fade-in", "label": "Fade in" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bulk enquiry form"
    }
  ]
}
{% endschema %}
