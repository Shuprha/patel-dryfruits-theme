    "collapsible_tabs_3hhDCw": {
      "type": "collapsible-tabs",
      "blocks": {
        "item_CUWfVY": {
          "type": "item",
          "settings": {
            "header": "What makes Patel Dry Fruit special?",
            "text_size": "h5",
            "content": "<p>Patel Dry Fruit brings together premium dry fruits, traditional taste, and modern healthy living. Every product is thoughtfully prepared to deliver freshness, nutrition, and everyday wellness in every bite.</p>",
            "content_page": "",
            "open": false
          }
        },
        "item_3wd4Yk": {
          "type": "item",
          "settings": {
            "header": "What kind of products does Patel Dry Fruit offer?",
            "text_size": "h5",
            "content": "<p>We offer a range of healthy and delicious products including energy boosters, dry fruit mixes, flavored nuts, traditional snacks, and wellness bites crafted for daily enjoyment.</p>",
            "content_page": "",
            "open": false
          }
        },
        "item_aeHDyV": {
          "type": "item",
          "settings": {
            "header": "Are Patel Dry Fruit products healthy for daily use?",
            "text_size": "h5",
            "content": "<p>Yes. Our products are made with carefully selected ingredients that are rich in nutrients, energy, and natural goodness — perfect for a balanced lifestyle and everyday snacking.</p>",
            "content_page": "",
            "open": false
          }
        },
        "item_M7F9q6": {
          "type": "item",
          "settings": {
            "header": "What does “crafted with care” mean at Patel Dry Fruit?",
            "text_size": "h5",
            "content": "<p>It means every ingredient is selected, mixed, and packed with attention to quality, taste, hygiene, and freshness so customers receive only the best experience.</p>",
            "content_page": "",
            "open": false
          }
        },
        "item_XgXGzd": {
          "type": "item",
          "settings": {
            "header": "s Patel Dry Fruit traditional or modern?",
            "text_size": "h5",
            "content": "<p>Patel Dry Fruit blends both worlds — the richness of traditional Indian flavors with modern packaging, premium presentation, and healthy lifestyle choices.</p>",
            "content_page": "",
            "open": false
          }
        },
        "item_rWeWHd": {
          "type": "item",
          "settings": {
            "header": "Why does Patel Dry Fruit focus on wellness?",
            "text_size": "h5",
            "content": "<p>Because we believe food should not only taste good but also make people feel good. Our goal is to create products that support energy, health, and mindful eating.</p>",
            "content_page": "",
            "open": false
          }
        },
        "item_hTdQVE": {
          "type": "item",
          "settings": {
            "header": "Where can you experience Patel Dry Fruit?",
            "text_size": "h5",
            "content": "<p>You can experience Patel Dry Fruit through our thoughtfully crafted products, gift boxes, festive collections, and everyday healthy bites made for modern lifestyles and meaningful gifting.</p>",
            "content_page": "",
            "open": false
          }
        }
      },
